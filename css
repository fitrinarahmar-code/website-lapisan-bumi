@import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;500;600;700;800;900&display=swap');

:root {
  --green: #347FC4;
  --dark: #225A91;
  --mint: #DDF2FF;
  --light: #EFF8FF;
  --cream: #FFF9E9;
  --text: #34536F;
  --shadow: 0 12px 35px rgba(52,127,196,.12);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

body {
  font-family: 'Nunito', sans-serif;
  color: var(--text);
  background: #F8FCFF;
  line-height: 1.7;
}

h1, h2, h3, h4 {
  font-family: 'Fredoka', sans-serif;
}

button, input {
  font: inherit;
}

button, a {
  -webkit-tap-highlight-color: transparent;
}

a {
  text-decoration: none;
  color: inherit;
}

/* NAVBAR */
.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 7%;
  background: rgba(255,255,255,.96);
  box-shadow: 0 3px 18px rgba(0,0,0,.06);
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 23px;
  font-weight: 900;
  color: var(--dark);
}

.brand img {
  width: 43px;
  height: 43px;
  object-fit: cover;
  border-radius: 50%;
}

.navbar nav {
  display: flex;
  align-items: center;
  gap: 26px;
}

.navbar nav a {
  font-weight: 800;
  font-size: 14px;
  transition: .25s;
}

.navbar nav a:hover {
  color: #F1B940;
}

.menu-toggle {
  display: none;
  background: var(--mint);
  border: 0;
  border-radius: 9px;
  padding: 7px 12px;
  font-size: 22px;
  color: var(--dark);
}

/* BERANDA */
.hero {
  min-height: 580px;
  padding: 75px 8%;
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  align-items: center;
  gap: 40px;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 90% 15%, #B9E3FF 0, transparent 33%),
    linear-gradient(120deg, #DDF2FF, #F5FAFF 55%, #FFF2CC);
}

.hero-content {
  max-width: 600px;
  position: relative;
  z-index: 2;
}

.eyebrow {
  display: inline-block;
  color: #347FC4;
  font-weight: 900;
  font-size: 12px;
  letter-spacing: 2px;
  margin-bottom: 14px;
}

.hero h1 {
  font-size: clamp(38px, 5vw, 66px);
  line-height: 1.13;
  color: #225A91;
  font-weight: 700;
  margin-bottom: 20px;
}

.hero h1 span {
  color: #E5A92F;
}

.hero-content > p {
  max-width: 540px;
  color: #58708A;
  font-size: 16px;
  margin-bottom: 28px;
}

.hero-buttons {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.btn {
  border: none;
  border-radius: 30px;
  padding: 13px 25px;
  font-weight: 900;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: .25s;
}

.btn:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow);
}

.btn-primary {
  background: #347FC4;
  color: white;
}

.btn-light {
  background: white;
  color: var(--dark);
  border: 1px solid #B9DDF5;
}

.hero-stats {
  display: flex;
  gap: 35px;
  margin-top: 42px;
}

.hero-stats div {
  display: flex;
  flex-direction: column;
}

.hero-stats strong {
  font-size: 22px;
  color: #347FC4;
  font-weight: 900;
}

.hero-stats span {
  font-size: 12px;
  color: #6E8499;
}

.hero-art {
  position: relative;
  min-height: 390px;
  display: grid;
  place-items: center;
}

.art-circle {
  position: absolute;
  width: 370px;
  height: 370px;
  border-radius: 50%;
  background: #B9E3FF;
  box-shadow: 0 0 0 25px rgba(255,255,255,.3);
}

.earth-image {
  position: relative;
  z-index: 1;
  width: min(350px, 90%);
  aspect-ratio: 1;
  object-fit: cover;
  border-radius: 50%;
  border: 9px solid white;
  box-shadow: 0 22px 45px rgba(35,90,130,.2);
  animation: float 5s ease-in-out infinite;
}

.floating-card {
  position: absolute;
  z-index: 2;
  bottom: 18px;
  left: -15px;
  background: white;
  padding: 12px 16px;
  border-radius: 18px;
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  gap: 12px;
  max-width: 255px;
}

.floating-card img {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  object-fit: cover;
}

.floating-card strong,
.floating-card small {
  display: block;
}

.floating-card strong {
  font-size: 13px;
}

.floating-card small {
  font-size: 10px;
  color: #75899B;
}

@keyframes float {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-13px); }
}

/* FITUR */
.features {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 18px;
  padding: 35px 8%;
  background: white;
}

.feature-item {
  padding: 20px;
  border-right: 1px solid #E5EEF7;
}

.feature-item:last-child {
  border: none;
}

.feature-icon {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: #DDF2FF;
  color: #347FC4;
  font-weight: 900;
  margin-bottom: 12px;
}

.feature-item h3 {
  font-size: 16px;
  margin-bottom: 4px;
}

.feature-item p {
  color: #788A9B;
  font-size: 12px;
}

/* MATERI */
.section {
  padding: 85px 8%;
  background: #F8FCFF;
}

.section-heading {
  text-align: center;
  max-width: 650px;
  margin: 0 auto 42px;
}

.section-heading h2 {
  font-size: clamp(28px,4vw,40px);
  color: var(--dark);
  font-weight: 700;
  margin-bottom: 8px;
}

.section-heading p {
  color: #75899B;
  font-size: 14px;
}

.layer-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 20px;
}

.layer-card {
  position: relative;
  overflow: hidden;
  border-radius: 23px;
  background: white;
  box-shadow: var(--shadow);
  transition: .3s;
}

.layer-card:hover {
  transform: translateY(-7px);
}

.layer-card > img {
  width: 100%;
  height: 180px;
  object-fit: cover;
}

.layer-number {
  position: absolute;
  top: 150px;
  right: 17px;
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  background: #FFE6A6;
  border-radius: 50%;
  color: var(--dark);
  font-weight: 900;
  border: 3px solid white;
}

.layer-body {
  padding: 22px;
}

.layer-body h3 {
  font-size: 19px;
  color: var(--dark);
  margin-bottom: 8px;
}

.layer-body p {
  color: #748798;
  font-size: 12px;
  min-height: 82px;
}

.text-button {
  border: 0;
  background: transparent;
  color: #347FC4;
  font-weight: 900;
  cursor: pointer;
  margin-top: 12px;
}

.text-button:hover {
  text-decoration: underline;
}

.detail-panel {
  margin-top: 25px;
  padding: 25px;
  background: #E7F4FF;
  border-radius: 20px;
  color: #315D83;
  border: 1px solid #CDE7FA;
  min-height: 90px;
}

.detail-panel h3 {
  margin-bottom: 7px;
}

.detail-panel p {
  font-size: 14px;
}

/* EKSPLORASI */
.explore-section {
  padding: 85px 8%;
  background: linear-gradient(140deg,#E8F5FF,#FFF9E9);
}

.explore-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 55px;
  background: white;
  border-radius: 28px;
  padding: 45px;
  box-shadow: var(--shadow);
}

.earth-cutaway {
  width: min(340px,90%);
  aspect-ratio: 1;
  margin: auto;
  border-radius: 50%;
  background: #53A8CB;
  padding: 10px;
  box-shadow: 0 20px 45px rgba(40,100,130,.18);
}

.earth-layer {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: grid;
  place-items: center;
  transition: .3s;
}

.crust {
  background: #579C48;
  padding: 14px;
}

.mantle {
  background: #ED963F;
  padding: 24px;
}

.outer-core {
  background: #F3C84E;
  padding: 22px;
}

.inner-core {
  width: 58%;
  height: 58%;
  background: radial-gradient(circle at 35% 30%,#FFF3A3,#DF7434);
  border-radius: 50%;
  box-shadow: 0 0 30px #FFC65B;
}

.explore-info h3 {
  font-size: 25px;
  color: var(--dark);
  margin-bottom: 10px;
}

.explore-info > p {
  color: #78899A;
  font-size: 14px;
  margin-bottom: 22px;
}

.layer-choice {
  display: block;
  width: 100%;
  padding: 12px 16px;
  border: 1px solid #DCEBF5;
  background: #F5FAFF;
  color: #386489;
  font-weight: 800;
  text-align: left;
  border-radius: 12px;
  margin-bottom: 10px;
  cursor: pointer;
  transition: .2s;
}

.layer-choice:hover,
.layer-choice.active {
  background: #DCEFFF;
  border-color: #83B8E5;
}

.explore-info .detail-panel {
  margin-top: 15px;
}

/* GAME */
.game-box,
.quiz-box,
.quiz-result {
  max-width: 800px;
  margin: auto;
  background: white;
  border-radius: 25px;
  padding: 35px;
  box-shadow: var(--shadow);
}

.game-top,
.quiz-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 14px;
}

.game-top h3 {
  color: var(--dark);
}

#gameScore {
  background: #FFEFC7;
  color: #9C711E;
  border-radius: 20px;
  padding: 6px 14px;
  font-weight: 900;
  font-size: 13px;
}

.game-box > p {
  color: #77899A;
  font-size: 14px;
  margin-bottom: 18px;
}

.matching-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25px;
}

.matching-grid h4 {
  margin-bottom: 12px;
  color: var(--dark);
}

.match-name,
.match-answer {
  width: 100%;
  min-height: 58px;
  padding: 12px;
  display: block;
  border-radius: 13px;
  border: 1px solid #DCEBF6;
  background: #F7FAFF;
  color: #385C78;
  font-weight: 800;
  text-align: left;
  cursor: pointer;
  margin-bottom: 10px;
  transition: .2s;
}

.match-name:hover,
.match-answer:hover,
.match-name.selected,
.match-answer.selected {
  border-color: #65A1D5;
  background: #E5F2FF;
}

.match-name.correct,
.match-answer.correct {
  background: #D7F0D8;
  border-color: #54A45D;
  cursor: default;
}

.match-name:disabled,
.match-answer:disabled {
  opacity: .75;
}

.game-message {
  min-height: 28px;
  font-weight: 800;
  color: #42814E !important;
  margin: 12px 0 15px !important;
}

/* KUIS */
.quiz-section {
  padding: 85px 8%;
  background: linear-gradient(140deg,#E8F5FF,#FFF9E9);
}

.progress-track {
  width: 100%;
  height: 10px;
  background: #E6EEF5;
  border-radius: 20px;
  overflow: hidden;
  margin: 15px 0 25px;
}

#quizProgress {
  width: 0;
  height: 100%;
  background: linear-gradient(90deg,#347FC4,#75C9F5);
  border-radius: 20px;
  transition: width .3s;
}

#questionNumber,
#quizProgressText {
  color: #347FC4;
  font-weight: 900;
}

#questionText {
  color: var(--dark);
  margin-bottom: 20px;
  font-size: 21px;
}

.answer-options {
  display: grid;
  gap: 12px;
}

.answer-options button {
  padding: 14px;
  border: 1px solid #DCEBF5;
  background: #F7FAFF;
  border-radius: 13px;
  text-align: left;
  color: #385C78;
  font-weight: 800;
  cursor: pointer;
  transition: .2s;
}

.answer-options button:hover {
  background: #E5F2FF;
  border-color: #65A1D5;
}

.answer-options button:disabled {
  cursor: default;
}

#quizFeedback {
  margin: 15px 0;
  font-weight: 800;
}

.quiz-result {
  text-align: center;
}

.quiz-result h3 {
  color: var(--dark);
}

#finalScore {
  display: block;
  font-size: 55px;
  color: #347FC4;
}

/* PROFIL */
.profile-box {
  max-width: 650px;
  margin: auto;
  display: flex;
  align-items: center;
  gap: 25px;
  padding: 30px;
  background: white;
  border-radius: 25px;
  box-shadow: var(--shadow);
}

.profile-avatar {
  width: 85px;
  height: 85px;
  min-width: 85px;
  display: grid;
  place-items: center;
  background: #DDF2FF;
  color: #347FC4;
  border-radius: 50%;
  font-size: 28px;
  font-weight: 900;
}

.profile-content {
  flex: 1;
}

.profile-content label {
  display: block;
  font-weight: 900;
  color: var(--dark);
  margin-bottom: 7px;
}

.profile-content input {
  width: 100%;
  padding: 12px 15px;
  border: 1px solid #CDE1F0;
  border-radius: 12px;
  outline: none;
  margin-bottom: 12px;
}

.profile-content input:focus {
  border-color: #347FC4;
}

.progress-cards {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 18px;
  margin-top: 25px;
}

.progress-cards div {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 25px 10px;
  background: white;
  border-radius: 20px;
  box-shadow: var(--shadow);
}

.progress-cards strong {
  color: #347FC4;
  font-size: 30px;
  font-weight: 900;
}

.progress-cards span {
  color: #78899A;
  font-size: 13px;
}

/* FOOTER */
footer {
  padding: 45px 8%;
  text-align: center;
  background: #225A91;
  color: white;
}

.footer-brand {
  font-family: 'Fredoka', sans-serif;
  font-size: 27px;
  font-weight: 700;
}

footer p {
  font-size: 13px;
  color: #DCEEFF;
  margin-top: 8px;
}

.copyright {
  margin-top: 20px;
  opacity: .8;
}

/* TOMBOL KEMBALI KE ATAS */
.back-top {
  position: fixed;
  right: 22px;
  bottom: 22px;
  width: 45px;
  height: 45px;
  border: none;
  border-radius: 50%;
  background: #347FC4;
  color: white;
  font-size: 23px;
  cursor: pointer;
  box-shadow: var(--shadow);
  z-index: 99;
}

/* RESPONSIVE HP DAN TABLET */
@media (max-width: 1000px) {
  .layer-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .features {
    grid-template-columns: repeat(2,1fr);
  }

  .hero {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 700px) {
  .navbar {
    padding: 12px 5%;
  }

  .menu-toggle {
    display: block;
  }

  .navbar nav {
    display: none;
    position: absolute;
    top: 70px;
    left: 0;
    width: 100%;
    padding: 20px;
    background: white;
    flex-direction: column;
    gap: 15px;
    box-shadow: 0 10px 20px rgba(0,0,0,.08);
  }

  .navbar nav.active {
    display: flex;
  }

  .hero {
    grid-template-columns: 1fr;
    text-align: center;
    padding: 55px 6%;
  }

  .hero-content {
    margin: auto;
  }

  .hero-buttons,
  .hero-stats {
    justify-content: center;
  }

  .hero-art {
    min-height: 320px;
  }

  .art-circle {
    width: 280px;
    height: 280px;
  }

  .earth-image {
    width: 270px;
  }

  .floating-card {
    left: 0;
    bottom: 0;
  }

  .features {
    padding: 25px 5%;
  }

  .feature-item {
    border: none;
    padding: 12px;
  }

  .section,
  .explore-section,
  .quiz-section {
    padding: 60px 5%;
  }

  .layer-grid {
    grid-template-columns: 1fr;
  }

  .layer-card > img {
    height: 210px;
  }

  .explore-layout {
    grid-template-columns: 1fr;
    padding: 25px 18px;
    gap: 30px;
  }

  .earth-cutaway {
    width: min(280px,90%);
  }

  .game-box,
  .quiz-box,
  .quiz-result {
    padding: 23px 18px;
  }

  .matching-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .profile-box {
    flex-direction: column;
    text-align: center;
  }

  .progress-cards {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 380px) {
  .hero h1 {
    font-size: 34px;
  }

  .hero-stats {
    gap: 17px;
  }

  .features {
    grid-template-columns: 1fr 1fr;
  }
}
